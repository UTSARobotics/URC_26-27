<mujoco model="simple_quadcopter">
    <compiler coordinate="local" inertiafromgeom="true"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>
        <light pos="0 0 5" dir="0 0 -1"/>
        <!-- Ground plane -->
        <geom name="floor" type="plane" size="10 10 0.1" rgba="0.8 0.8 0.8 1"/>
        
        <!-- Quadcopter Fuselage Box centered at 0.5 meters high -->
        <body name="chassis" pos="0 0 0.5">
            <freejoint name="root"/>
            <geom type="box" size="0.15 0.15 0.04" rgba="0.1 0.5 0.8 1" mass="1.0"/>
            
            <!-- Standard X-Configuration Arms (Radiating correctly from the corners) -->
            <geom type="cylinder" fromto="0 0 0   0.25  0.25 0" size="0.015" rgba="0.1 0.1 0.1 1"/>
            <geom type="cylinder" fromto="0 0 0  -0.25  0.25 0" size="0.015" rgba="0.1 0.1 0.1 1"/>
            <geom type="cylinder" fromto="0 0 0   0.25 -0.25 0" size="0.015" rgba="0.1 0.1 0.1 1"/>
            <geom type="cylinder" fromto="0 0 0  -0.25 -0.25 0" size="0.015" rgba="0.1 0.1 0.1 1"/>

            <!-- Motor thrust anchor sites placed exactly at the arm tips -->
            <site name="motor1_site" pos=" 0.25  0.25 0.01" size="0.01"/>
            <site name="motor2_site" pos="-0.25 -0.25 0.01" size="0.01"/>
            <site name="motor3_site" pos=" 0.25 -0.25 0.01" size="0.01"/>
            <site name="motor4_site" pos="-0.25  0.25 0.01" size="0.01"/>

            <!-- Fixed IMU Sensor site (welded inside the box frame) -->
            <site name="imu" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
        </body>
    </worldbody>

    <!-- Actuators mapped to spatial sites -->
    <actuator>
        <motor name="motor1" site="motor1_site" gear="0 0 25 0 0 0"/>
        <motor name="motor2" site="motor2_site" gear="0 0 25 0 0 0"/>
        <motor name="motor3" site="motor3_site" gear="0 0 25 0 0 0"/>
        <motor name="motor4" site="motor4_site" gear="0 0 25 0 0 0"/>
    </actuator>
</mujoco>
